# GRABB-IT Backend Configuration Environment Variables

# The server port (defaults to 5000)
PORT=5000

# Node runtime environment (development or production)
NODE_ENV=development

# JWT security secret key for authentication token hashing
JWT_SECRET=grabb_it_super_secret_jwt_key_2026

# Production/development object storage configuration (if configured later)
STORAGE_API_KEY=
STORAGE_SECRET_KEY=

# Production/development payment gateway integration configurations (if configured later)
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
