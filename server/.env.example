# GRABB-IT Backend Environment Configuration Variables

# Node Environment & Port
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Security Secrets
JWT_SECRET=grabb_it_super_secret_jwt_key_production_2026

# PostgreSQL Database Configuration (Required for Render / Production)
# DATABASE_URL=postgresql://grabb_it_user:password@ep-sample-12345.postgresql.render.com/grabb_it_db?sslmode=require

# Cloudinary Storage Configuration (Required for Production Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Configuration (Test or Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email SMTP Server Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="GRABB-IT Clothing <noreply@grabb-it.com>"
