{
  "name": "grabb-it",
  "version": "1.0.0",
  "description": "GRABB-IT Full-Stack E-Commerce Clothing Website",
  "main": "server/server.js",
  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client",
    "seed": "node server/database/seed.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm install --prefix client --legacy-peer-deps && npm run build --prefix client",
    "vercel-build": "npm install --prefix client --legacy-peer-deps && npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^0.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8"
  }
}
